{
    "name": "markup-carve/symfony-carve-demo",
    "description": "Demo Symfony application showcasing the symfony-carve bundle (Carve markup rendering).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "markup-carve/symfony-carve": "^0.1.4",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/twig": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
