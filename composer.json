{
    "name": "markup-carve/symfony-carve-demo",
    "description": "Demo Symfony application showcasing the symfony-carve bundle (Carve markup rendering).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "markup-carve/carve-php": "dev-next2#6ceebc52181efc1f5dfe6f5e7964b75c43f13a90",
        "markup-carve/symfony-carve": "dev-next2",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/twig": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "export-static": "STATIC_EXPORT=true APP_ENV=prod APP_DEBUG=0 php bin/console demo:export",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    }
}
