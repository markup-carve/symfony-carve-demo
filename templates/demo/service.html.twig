{% extends 'base.html.twig' %}

{% block title %}Service &middot; symfony-carve{% endblock %}

{% block body %}
    <div class="card">
        <h2>CarveRenderer service</h2>
        <p class="lead">Inject the renderer anywhere via autowiring and call <code>render()</code>:</p>
        <pre><code>use MarkupCarve\Symfony\CarveRenderer;

public function show(CarveRenderer $carve): Response
{
    $html = $carve->render('# Hello *world*');

    return new Response($html);
}</code></pre>
    </div>

    <div class="columns">
        <div class="card">
            <div class="label">Carve source</div>
            <pre><code>{{ source }}</code></pre>
        </div>
        <div class="card">
            <div class="label">render() output (raw HTML)</div>
            <pre><code>{{ html }}</code></pre>
            <div class="label" style="margin-top:15px;">Rendered in the browser</div>
            <div class="rendered">{{ html|raw }}</div>
        </div>
    </div>
{% endblock %}
