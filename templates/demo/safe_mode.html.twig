{% extends 'base.html.twig' %}

{% block title %}Safe Output &middot; symfony-carve{% endblock %}

{% block body %}
    <div class="card">
        <h2>Safe output</h2>
        <p class="lead">
            Carve 0.2 escapes raw HTML blocks and spans unless <code>raw_html</code> is true, and the URL policy blanks
            denied link schemes such as <code>javascript:</code>. Both are safe by default.
        </p>
        <pre><code>carve:
    raw_html: false     # default; true only for trusted input
    url_policy: []      # engine default; or {allow: [https]} / {deny: [...]}</code></pre>
        <div class="label">Untrusted source (contains XSS attempts)</div>
        <pre><code>{{ source }}</code></pre>
    </div>

    <div class="columns">
        <div class="card">
            <div class="label">raw_html: false (default) <span class="badge badge-safe">safe</span></div>
            <p>Raw HTML is shown as text and the <code>javascript:</code> link is blanked.</p>
            <pre id="safe-escaped"><code>{{ escaped }}</code></pre>
            <div class="rendered carve">{{ escaped|raw }}</div>
        </div>
        <div class="card">
            <div class="label">url_policy: {allow: [https]} <span class="badge badge-safe">safe</span></div>
            <p>Only <code>https</code> links survive; the <code>mailto:</code> link is blanked too.</p>
            <pre id="safe-https-only"><code>{{ https_only }}</code></pre>
            <div class="rendered carve">{{ https_only|raw }}</div>
        </div>
    </div>

    <div class="card">
        <div class="label">raw_html: true <span class="badge badge-unsafe">unsafe</span></div>
        <p>Raw HTML passes through unchanged. Only use with fully trusted input; it is not rendered on this page.</p>
        <pre id="safe-trusted"><code>{{ trusted }}</code></pre>
    </div>
{% endblock %}
