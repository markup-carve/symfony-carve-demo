{% extends 'base.html.twig' %}

{% block title %}Extensions &middot; symfony-carve{% endblock %}

{% block body %}
    <div class="card">
        <h2>Extensions</h2>
        <p class="lead">The <code>extensions</code> key takes Carve <code>ExtensionDefinition</code> or
            <code>ExtensionProvider</code> objects, or one of the bundle's shortcuts.</p>
        <pre><code>carve:
    extensions:
        - tabs
        - { type: wikilinks, url_template: 'https://github.com/markup-carve/symfony-carve/wiki/{page}' }
        # also: { type: heading_permalinks, symbol: '#' }, autolink,
        # mermaid, plantuml (diagram fences)</code></pre>
        <p>Frontmatter, the table of contents, autolinks in angle brackets and smart typography are core Carve 0.2 and need no registration.</p>
        <div class="label">Carve source</div>
        <pre><code>{{ source }}</code></pre>
    </div>

    <div class="columns">
        <div class="card">
            <div class="label">With tabs and wikilinks (the configured service)</div>
            <div class="rendered" id="extensions-on">{{ html|raw }}</div>
            <pre><code>{{ html }}</code></pre>
        </div>
        <div class="card">
            <div class="label">No extensions registered</div>
            <p>Unregistered divs and inline extensions keep their fallback rendering.</p>
            <div class="rendered" id="extensions-off">{{ plain_html|raw }}</div>
            <pre><code>{{ plain_html }}</code></pre>
        </div>
    </div>

    <div class="card">
        <div class="label">mode: static</div>
        <p>In static mode the tabs render as sections with headings, and inline extensions fall back to plain text, for pages without interactive markup.</p>
        <div class="rendered" id="extensions-static">{{ static_html|raw }}</div>
    </div>

    <div class="card">
        <div class="label">heading_permalinks and autolink</div>
        <p>The <code>heading_permalinks</code> shortcut adds a link to each heading (its options are <code>symbol</code>,
            <code>cssClass</code>, <code>ariaLabel</code>, <code>levels</code>, <code>prepend</code>, <code>showOnHover</code>
            and <code>copyToClipboard</code>), and <code>autolink</code> turns bare <code>https</code>, <code>http</code> and
            <code>mailto</code> addresses into links. This card uses a separate renderer so the other pages keep plain headings.</p>
        <pre><code>new CarveRenderer(extensions: [['type' => 'heading_permalinks', 'symbol' => '#'], 'autolink']);</code></pre>
        <div class="rendered" id="extensions-permalinks-rendered">{{ permalinks_html|raw }}</div>
        <pre id="extensions-permalinks"><code>{{ permalinks_html }}</code></pre>
    </div>
{% endblock %}
