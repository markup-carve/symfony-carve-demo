{% extends 'base.html.twig' %}

{% block title %}File includes{% endblock %}

{% block body %}
    <div class="card">
        <h1>File Includes</h1>
        <p>Only <code>renderFileWithReport()</code> expands includes. The configured root keeps every target contained.</p>
        <pre><code>{{ source }}</code></pre>
        <h2>Rendered result</h2>
        <div class="rendered">{{ html|raw }}</div>
        <h2>Dependencies</h2>
        <ul>{% for dependency in dependencies %}<li><code>{{ dependency.path }}</code> — {{ dependency.resolved ? 'resolved' : 'missing' }}</li>{% endfor %}</ul>
        {% if warnings is not empty %}<h2>Warnings</h2><ul>{% for warning in warnings %}<li>{{ warning.message }}</li>{% endfor %}</ul>{% endif %}
    </div>
{% endblock %}
